# ==============================================================================
# PawConnect Spring Boot Backend - Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Port
SERVER_PORT=8000

# PostgreSQL Database Configuration (Neon / Local)
DB_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security
JWT_SECRET=your_base64_encoded_256_bit_secret_key_here_min_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Razorpay Payment Gateway Credentials
# For local development/testing, obtain test keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Set to true only in automated testing or offline mock environments where Razorpay SDK is mocked
RAZORPAY_MOCK_CLIENT=false

# CORS Configuration (Frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email Notifications (Optional SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
NOTIFICATION_EMAIL_ENABLED=false
