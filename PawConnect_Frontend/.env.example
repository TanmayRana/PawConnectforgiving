# PawConnect Next.js Frontend - Environment Configuration

# Backend REST API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# WebSocket / STOMP Real-Time Notification Server
NEXT_PUBLIC_WS_URL=http://localhost:8000/ws

# Public Razorpay Test Key ID (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Storage Provider Configuration
# Set to 'local' (default) or 'cloudinary'
STORAGE_PROVIDER=local

# Cloudinary Configuration (Optional - uncomment and fill when migrating from local storage to Cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_UPLOAD_PRESET=your_upload_preset
